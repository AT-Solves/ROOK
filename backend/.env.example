# --- Core ---
# SQLite by default; for Postgres use e.g. postgresql+psycopg://rook:rook@localhost:5432/rook
ROOK_DATABASE_URL=sqlite:///./rook.db
# Used to sign session tokens. CHANGE THIS in any shared environment.
ROOK_SECRET_KEY=dev-only-change-me
# Allow passwordless email login for the prototype (disable once OIDC is wired).
ROOK_DEV_LOGIN=true
# Comma-separated origins allowed to call the API (the Next.js frontend).
ROOK_CORS_ORIGINS=http://localhost:3000

# --- AI provider ---
# one of: rules (no LLM, deterministic extraction), anthropic, openai, ollama
ROOK_LLM_PROVIDER=rules
ROOK_ANTHROPIC_API_KEY=
ROOK_ANTHROPIC_MODEL=claude-sonnet-5-5
ROOK_OPENAI_API_KEY=
ROOK_OPENAI_MODEL=gpt-4.1
ROOK_OLLAMA_URL=http://localhost:11434
ROOK_OLLAMA_MODEL=llama3.1

# --- Connectors (Phase 1; not needed for the demo connector) ---
ROOK_GOOGLE_CLIENT_ID=
ROOK_GOOGLE_CLIENT_SECRET=
ROOK_MICROSOFT_CLIENT_ID=
ROOK_MICROSOFT_CLIENT_SECRET=
ROOK_MICROSOFT_TENANT_ID=
ROOK_SLACK_CLIENT_ID=
ROOK_SLACK_CLIENT_SECRET=
