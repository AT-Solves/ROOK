# ROOK backend configuration. Copy to backend/.env for local runs. NEVER commit real values.

# --- Core ---
# development (default) | production. Production refuses to start with demo login on, a default/short
# ROOK_SECRET_KEY, no ROOK_ENCRYPTION_KEY, or ROOK_ADMIN_EMAILS set (ADR-0011).
ROOK_ENVIRONMENT=development
# SQLite locally; PostgreSQL for shared environments, e.g. postgresql+psycopg://rook:rook@localhost:5432/rook
ROOK_DATABASE_URL=sqlite:///./rook.db
# Signs session tokens. Generate: python -c "import secrets; print(secrets.token_urlsafe(48))"
ROOK_SECRET_KEY=dev-only-change-me
# Encrypts connector OAuth tokens at rest. Required when ROOK_DEV_LOGIN=false.
# Generate: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
ROOK_ENCRYPTION_KEY=
# Passwordless demo login + synthetic demo tenant. MUST be false in any shared environment.
ROOK_DEV_LOGIN=true
# IANA time zone for the demo tenant's users and its synthetic agenda (meetings fall in local working hours).
# Set it to your own zone before the first start (e.g. Asia/Kolkata); the demo DB must be recreated to change it.
ROOK_DEMO_TIMEZONE=UTC
# URLs used for OAuth redirects and CORS.
ROOK_PUBLIC_API_URL=http://localhost:8000
ROOK_WEB_URL=http://localhost:3000
ROOK_CORS_ORIGINS=http://localhost:3000
# DEVELOPMENT ONLY: comma-separated emails made admins on sign-in. Ignored (and refused) in production, where the
# first user from a new Microsoft tenant owns the new organization (ADR-0011).
ROOK_ADMIN_EMAILS=

# --- Microsoft 365 / Entra ID, multi-tenant (see docs/integrations/microsoft365.md) ---
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=
# Optional: comma-separated Entra tenant ids allowed to sign in. Empty = any work or school tenant.
MICROSOFT_ALLOWED_TENANT_IDS=
# Personal Microsoft accounts (outlook.com, hotmail.com, live.com), ADR-0012. Off by default; keep false unless the
# Entra app also supports personal accounts. When true, each personal account gets its own private workspace.
MICROSOFT_ALLOW_PERSONAL_ACCOUNTS=false
# Legacy single-tenant setting: if set, it restricts sign-in to that one tenant. Leave empty for multi-tenant.
MICROSOFT_TENANT_ID=
# Teams meeting transcripts "where permitted" (needs admin consent for OnlineMeetingTranscript.Read.All).
MICROSOFT_ENABLE_TRANSCRIPTS=true
# Sending approved follow-ups from the user's mailbox (requests Mail.Send). Off by default.
MICROSOFT_ENABLE_SEND=false
MICROSOFT_MAX_MESSAGES_PER_SYNC=500

# --- AI provider ---
# rules (deterministic, no LLM) | anthropic | openai | ollama (experimental, unsupported — P2)
ROOK_LLM_PROVIDER=rules
ROOK_ANTHROPIC_API_KEY=
ROOK_ANTHROPIC_MODEL=claude-sonnet-5-5
ROOK_OPENAI_API_KEY=
ROOK_OPENAI_MODEL=gpt-4.1
ROOK_OLLAMA_URL=http://localhost:11434
ROOK_OLLAMA_MODEL=llama3.1
